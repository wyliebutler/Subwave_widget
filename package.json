{
  "name": "subwave-widget",
  "productName": "SubWave Widget",
  "version": "1.1.0",
  "description": "Compact desktop radio widget for self-hosted SUB/WAVE stations (Windows & macOS Apple Silicon)",
  "main": "src/main.js",
  "author": "Wylie Butler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyliebutler/Subwave_widget.git"
  },
  "homepage": "https://github.com/wyliebutler/Subwave_widget#readme",
  "bugs": {
    "url": "https://github.com/wyliebutler/Subwave_widget/issues"
  },
  "scripts": {
    "icon": "node scripts/generate-icon.js",
    "start": "electron .",
    "pack": "npm run icon && electron-builder --dir",
    "dist:win": "npm run icon && electron-builder --win nsis portable --publish never",
    "dist:mac": "npm run icon && electron-builder --mac dmg zip --arm64 --publish never",
    "dist": "npm run dist:win"
  },
  "build": {
    "appId": "org.subwave.desktop-widget",
    "productName": "SubWave Widget",
    "afterPack": "scripts/after-pack.js",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "SubWave-Widget-Setup.exe"
    },
    "portable": {
      "artifactName": "SubWave-Widget-Portable.exe"
    },
    "mac": {
      "icon": "assets/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "artifactName": "SubWave-Widget-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}
